NODE_ENV=production
HOST=127.0.0.1
TRUST_PROXY=true
PORT=3100
LOG_LEVEL=info
WEB_ORIGIN=https://manbaout.com

PERSISTENCE_PROVIDER=postgres
POSTGRES_DB=littletask
POSTGRES_USER=littletask
POSTGRES_PORT=5432
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_RANDOM_PASSWORD
DATABASE_URL=postgresql://littletask:CHANGE_ME_URL_SAFE_RANDOM_PASSWORD@127.0.0.1:5432/littletask?schema=public
JOB_MAX_ATTEMPTS=3
JOB_LEASE_MS=300000
JOB_POLL_MS=1000

AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.hostcentral.cc
OPENAI_WIRE_API=responses
OPENAI_API_KEY=CHANGE_ME_ROTATED_RUNTIME_KEY
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=xhigh
OPENAI_STORE=false
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=0
OPENAI_MAX_OUTPUT_TOKENS=16000
AI_NETWORK_ACCESS=enabled

MAX_UPLOAD_BYTES=10485760
IMAGE_RETENTION=none
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_UPLOADS=20
RATE_LIMIT_REGISTRATIONS=10
RATE_LIMIT_WINDOW_MS=60000
