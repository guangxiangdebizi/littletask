{
  "name": "littletask",
  "version": "0.1.0",
  "private": true,
  "description": "Turn chat screenshots into confirmable actions and grounded personal insights.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @littletask/api --filter @littletask/mobile dev",
    "dev:api": "corepack pnpm --filter @littletask/api dev",
    "dev:worker": "corepack pnpm --filter @littletask/api dev:worker",
    "dev:mobile": "corepack pnpm --filter @littletask/mobile dev",
    "db:generate": "corepack pnpm --filter @littletask/api db:generate",
    "db:migrate:deploy": "corepack pnpm --filter @littletask/api db:migrate:deploy",
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "lint": "eslint apps/api/src packages/contracts/src packages/domain/src && corepack pnpm --filter @littletask/mobile lint",
    "test": "corepack pnpm -r --if-present test",
    "test:integration": "corepack pnpm --filter @littletask/api test:integration",
    "eval:ai": "corepack pnpm --filter @littletask/ai-evals eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0"
  }
}
