# Runtime
NODE_ENV=development
LITTLETASK_ENV_FILE=
HOST=127.0.0.1
TRUST_PROXY=false
PORT=3100
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:8081

# Database
DATABASE_URL=postgresql://littletask:littletask@localhost:5432/littletask?schema=public
PERSISTENCE_PROVIDER=memory
JOB_MAX_ATTEMPTS=3
JOB_LEASE_MS=300000
JOB_POLL_MS=1000

# AI provider
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.hostcentral.cc
OPENAI_WIRE_API=responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=xhigh
OPENAI_STORE=false
OPENAI_TIMEOUT_MS=180000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=16000
AI_NETWORK_ACCESS=enabled

# Upload and processing
MAX_UPLOAD_BYTES=10485760
IMAGE_RETENTION=none
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_UPLOADS=20
RATE_LIMIT_REGISTRATIONS=10
RATE_LIMIT_WINDOW_MS=60000
