{
  "name": "@littletask/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/app.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "postinstall": "prisma generate",
    "build": "tsup",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/persistence.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@littletask/contracts": "workspace:*",
    "@littletask/domain": "workspace:*",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "openai": "6.48.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  }
}
