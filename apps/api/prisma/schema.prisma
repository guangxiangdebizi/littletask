generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IntakeStatus {
  queued
  processing
  ready
  failed
}

enum AnalysisJobStatus {
  queued
  processing
  retry
  succeeded
  failed
}

enum ModelRunStage {
  analysis
  review
}

enum ModelRunStatus {
  succeeded
  failed
}

enum RevisionSource {
  ai
  user
  system
}

enum ExecutionStatus {
  succeeded
  failed
}

model Intake {
  id                  String       @id @db.Uuid
  status              IntakeStatus
  note                String?
  locale              String
  timezone            String
  imageSha256         String       @map("image_sha256") @db.Char(64)
  imageMimeType       String       @map("image_mime_type")
  imageBytes          Int          @map("image_bytes")
  imageOriginalName   String?      @map("image_original_name")
  summary             String?
  participants        Json
  facts               Json
  uncertainties       Json
  clarifyingQuestions Json         @map("clarifying_questions")
  error               Json?
  createdAt           DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @map("updated_at") @db.Timestamptz(3)

  actions   Action[]
  insights  Insight[]
  modelRuns ModelRun[]
  job       AnalysisJob?

  @@index([createdAt(sort: Desc)])
  @@map("intakes")
}

model Action {
  id          String   @id @db.Uuid
  intakeId    String   @map("intake_id") @db.Uuid
  type        String
  status      String
  revision    Int
  confidence  String
  evidence    Json
  assumptions Json
  payload     Json
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  intake        Intake               @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  revisions     ActionRevision[]
  confirmations ActionConfirmation[]
  executions    ActionExecution[]
  insights      Insight[]

  @@index([intakeId])
  @@map("actions")
}

model ActionRevision {
  id        String         @id @db.Uuid
  actionId  String         @map("action_id") @db.Uuid
  revision  Int
  source    RevisionSource
  snapshot  Json
  createdAt DateTime       @map("created_at") @db.Timestamptz(3)

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, revision])
  @@index([actionId])
  @@map("action_revisions")
}

model ActionConfirmation {
  id             String   @id @db.Uuid
  actionId       String   @map("action_id") @db.Uuid
  revision       Int
  idempotencyKey String   @unique @map("idempotency_key") @db.Uuid
  confirmedAt    DateTime @map("confirmed_at") @db.Timestamptz(3)

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("action_confirmations")
}

model ActionExecution {
  id              String          @id @db.Uuid
  actionId        String          @map("action_id") @db.Uuid
  idempotencyKey  String          @unique @map("idempotency_key") @db.Uuid
  status          ExecutionStatus
  nativeRecordRef String?         @map("native_record_ref")
  errorMessage    String?         @map("error_message")
  createdAt       DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @map("updated_at") @db.Timestamptz(3)

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("action_executions")
}

model Insight {
  id        String   @id @db.Uuid
  intakeId  String   @map("intake_id") @db.Uuid
  actionId  String?  @map("action_id") @db.Uuid
  type      String
  priority  String
  title     String
  body      String
  evidence  Json
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  intake Intake  @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  action Action? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([intakeId])
  @@map("insights")
}

model ModelRun {
  id              String         @id @db.Uuid
  intakeId        String         @map("intake_id") @db.Uuid
  stage           ModelRunStage
  status          ModelRunStatus
  provider        String
  model           String
  reasoningEffort String         @map("reasoning_effort")
  promptVersion   String         @map("prompt_version")
  schemaVersion   String         @map("schema_version")
  durationMs      Int            @map("duration_ms")
  inputTokens     Int?           @map("input_tokens")
  outputTokens    Int?           @map("output_tokens")
  totalTokens     Int?           @map("total_tokens")
  responseId      String?        @map("response_id")
  errorCode       String?        @map("error_code")
  startedAt       DateTime       @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime       @map("completed_at") @db.Timestamptz(3)

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId, stage])
  @@map("model_runs")
}

model AnalysisJob {
  id            String            @id @db.Uuid
  intakeId      String            @unique @map("intake_id") @db.Uuid
  status        AnalysisJobStatus
  imagePayload  Bytes?            @map("image_payload") @db.ByteA
  mimeType      String            @map("mime_type")
  contextNow    DateTime          @map("context_now") @db.Timestamptz(3)
  attempts      Int               @default(0)
  maxAttempts   Int               @map("max_attempts")
  availableAt   DateTime          @map("available_at") @db.Timestamptz(3)
  lockedAt      DateTime?         @map("locked_at") @db.Timestamptz(3)
  lockedBy      String?           @map("locked_by")
  lastErrorCode String?           @map("last_error_code")
  completedAt   DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @map("updated_at") @db.Timestamptz(3)

  intake Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("analysis_jobs")
}
